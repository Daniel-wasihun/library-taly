APP_NAME="UniLibrary Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=https://your-service-name.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==============================================================================
# Supabase PostgreSQL Configuration
# In Supabase -> Project Settings -> Database:
# - If using Direct Connection (IPv6 / IPv4 add-on): Port 5432, Host db.<ref>.supabase.co
# - If using Connection Pooler (Session / Transaction mode): Port 5432 or 6543
#   Host e.g. aws-0-eu-central-1.pooler.supabase.com, User postgres.<ref>
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require

# ==============================================================================
# Sessions & Caching (Using file driver for reliable single-container deployment)
# ==============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ==============================================================================
# Render & Container Flags
# ==============================================================================
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# ==============================================================================
# Sanctum & SPA CORS
# Add your Render domain without protocol, e.g.: your-service-name.onrender.com
# ==============================================================================
SANCTUM_STATEFUL_DOMAINS=your-service-name.onrender.com
VITE_APP_NAME="${APP_NAME}"
